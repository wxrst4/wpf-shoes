<Window x:Class="wpf_shoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="290" Width="440"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <TextBlock Text="Логин" Margin="0,30,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tb_login" Margin="100,25,0,0" Width="230" Height="28"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Пароль" Margin="0,80,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="tb_password" Margin="100,75,0,0" Width="230" Height="28"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Button Content="Войти" Click="Btn_SingIn"
                Width="105" Height="32" Margin="100,135,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Content="Гость" Click="Btn_SingInGuest"
                Width="105" Height="32" Margin="225,135,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Window>
