<Window x:Class="wpf_shoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <TextBlock Text="Логин" Margin="177,156,-177,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tb_login" Margin="254,150,0,0" Width="230" Height="28"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Пароль" Margin="177,203,-177,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="tb_password" Margin="255,197,0,0" Width="230" Height="28"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Button Content="Войти" Click="Btn_SingIn"
                Width="105" Height="32" Margin="254,243,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Content="Гость" Click="Btn_SingInGuest"
                Width="105" Height="32" Margin="380,243,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Window>
