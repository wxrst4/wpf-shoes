<Window x:Class="wpf_shoes.admin.CreateOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_shoes.admin"
        mc:Ignorable="d"
        Title="CreateOrderWindow" Height="450" Width="800">

    <Grid x:Name="OrderForm"
        Height="200"
        Margin="0,0,0,0"
        VerticalAlignment="Top"
>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="541*"/>
            <ColumnDefinition Width="259*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="ID заказа" Margin="10,0,0,0"
               VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbOrderId" Width="170" Height="25"
             Margin="155,0,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Артикул" Margin="370,0,0,0"
               VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbArticleNumber" Width="170" Height="25"
             Margin="520,0,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <TextBlock Text="Дата создания" Margin="10,38,0,0"
               VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbCreatedAt" Width="170" Height="25"
             Margin="155,38,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Дата доставки" Margin="370,38,0,0"
               VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbDeliveredAt" Width="170" Height="25"
             Margin="520,38,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <TextBlock Text="ID адреса" Margin="10,76,0,0"
               VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbAddressId" Width="170" Height="25"
             Margin="155,76,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="ID пользователя" Margin="370,76,0,0"
               VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbUserId" Width="170" Height="25"
             Margin="520,76,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <TextBlock Text="Код заказа" Margin="10,114,0,0"
               VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbCode" Width="170" Height="25"
             Margin="155,114,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Статус" Margin="370,114,0,0"
               VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbStatus" Width="170" Height="25"
             Margin="520,114,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <Button Content="Добавить заказ"
            Width="170" Height="30"
            Margin="155,155,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BtnAddOrder"/>
    </Grid>

</Window>
